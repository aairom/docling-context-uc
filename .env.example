# Copy this file to `.env` and adjust. No value here is a secret by default.

# --- Identity (multi-tenant scoping in docling-context) ----------------------
DC_TENANT_ID=demo
DC_USER_ID=local

# --- Folders -----------------------------------------------------------------
DC_INPUT_DIR=./input
DC_OUTPUT_DIR=./output
DC_STORE_DIR=./context-data
# Collection that ingested documents are placed in: docling://resources/<collection>/...
DC_COLLECTION=knowledge

# --- Optional features ---------------------------------------------------------
# Enable Docling conversion for PDF / Office / images (requires: uv sync --extra conversion)
DC_ENABLE_CONVERSION=false
# Enable vector + hybrid search (requires: uv sync --extra vectors; downloads a model once)
DC_ENABLE_VECTORS=false
DC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Local LLM (OpenAI-compatible, e.g. llama.cpp server or Ollama) ------------
# Leave LLM_BASE_URL empty to run fully extractive (no LLM).
LLM_BASE_URL=http://localhost:9931/v1
LLM_MODEL=local-model
# Only needed if your local server enforces a key.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Use the LLM to write document summaries during ingestion (falls back automatically).
LLM_SUMMARIES=false

# --- Web UI --------------------------------------------------------------------
# Do not use 5000 on macOS (AirDrop).
APP_HOST=127.0.0.1
APP_PORT=7860
LOG_LEVEL=INFO
